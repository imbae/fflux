<Page
    x:Class="fflux.UI.Modules.AiSubtitle.AiSubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:local="clr-namespace:fflux.UI.Modules.AiSubtitle"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:AiSubtitleViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    Title="AI Subtitle">

    <Page.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter             x:Key="InvBool" />
        <BooleanToVisibilityConverter          x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter      x:Key="StrToVis" />
    </Page.Resources>

    <!--
        루트 Grid: 상단(*) 스크롤 영역 + 하단(200) 고정 로그 패널
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- ══ 상단: 설정 + 실행 (스크롤 가능) ══════════════════════════ -->
        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="24,16"
                MaxWidth="720">

                <!-- 페이지 헤더 -->
                <TextBlock
                    Text="AI 자막 생성"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="동영상 파일에서 Whisper로 음성을 전사하고 Groq / DeepL로 번역한 .srt 파일을 생성합니다."
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,20" />

                <!-- ── 🖥 서버 카드 ─────────────────────────────────── -->
                <ui:CardExpander
                    Header="🖥 Whisper 서버"
                    IsExpanded="True"
                    Margin="0,0,0,10">
                    <StackPanel>

                        <!-- 서버 상태 표시 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ServerStatusText}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                            <!-- 상태 확인 버튼 -->
                            <ui:Button
                                Grid.Column="1"
                                Content="상태 확인"
                                Appearance="Secondary"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Command="{Binding CheckServerCommand}"
                                Padding="10,4" />

                            <!-- 서버 시작 버튼 (로컬 서버일 때만) -->
                            <ui:Button
                                Grid.Column="3"
                                Content="서버 시작"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon Play24}"
                                Command="{Binding StartServerCommand}"
                                Padding="10,4"
                                Visibility="{Binding IsLocalServer, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- 모델 + 디바이스 선택 (로컬 서버일 때만) -->
                        <StackPanel
                            Visibility="{Binding IsLocalServer, Converter={StaticResource BoolToVis}}">

                            <Grid
                                IsEnabled="{Binding IsServerRunning, Converter={StaticResource InvBool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Whisper 모델 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Text="Whisper 모델"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,0,0,4" />
                                    <ComboBox
                                        ItemsSource="{x:Static local:AiSubtitleViewModel.WhisperModels}"
                                        SelectedItem="{Binding SelectedWhisperModel}"
                                        IsEnabled="{Binding IsStartingServer, Converter={StaticResource InvBool}}" />
                                </StackPanel>

                                <!-- 디바이스 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox
                                        Content="GPU 사용 (CUDA)"
                                        IsChecked="{Binding UseGpu}"
                                        IsEnabled="{Binding IsStartingServer, Converter={StaticResource InvBool}}"
                                        FontSize="13" />
                                </StackPanel>
                            </Grid>

                            <!-- 시작 중 진행 표시 -->
                            <ProgressBar
                                Margin="0,10,0,0"
                                Height="4"
                                IsIndeterminate="True"
                                Visibility="{Binding IsStartingServer, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                    </StackPanel>
                </ui:CardExpander>

                <!-- ── 📁 소스 동영상 ─────────────────────────────────── -->
                <ui:CardExpander
                    Header="📁 소스 동영상 파일"
                    IsExpanded="True"
                    Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock
                            Text="동영상 파일"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                Text="{Binding MediaFilePath, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="파일 경로를 입력하거나 찾아보기를 클릭하세요"
                                IsReadOnly="True" />
                            <ui:Button
                                Grid.Column="2"
                                Content="찾아보기"
                                Command="{Binding BrowseMediaFileCommand}"
                                Appearance="Secondary" />
                        </Grid>

                        <TextBlock
                            Text="출력 .srt 경로 (비우면 동영상 파일과 같은 폴더에 자동 저장)"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                Text="{Binding OutputSrtPath, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="(자동)" />
                            <ui:Button
                                Grid.Column="2"
                                Content="찾아보기"
                                Command="{Binding BrowseOutputPathCommand}"
                                Appearance="Secondary" />
                        </Grid>

                    </StackPanel>
                </ui:CardExpander>

                <!-- ── 🌐 번역 설정 ────────────────────────────────────── -->
                <ui:CardExpander
                    Header="🌐 번역 설정"
                    IsExpanded="True"
                    Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Text="소스 언어 (원본)"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,4" />
                                <ComboBox
                                    ItemsSource="{x:Static local:AiSubtitleViewModel.SourceLanguages}"
                                    SelectedValuePath="Code"
                                    SelectedValue="{Binding SourceLanguage}"
                                    DisplayMemberPath="DisplayName" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Text="대상 언어"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,4" />
                                <ComboBox
                                    ItemsSource="{x:Static local:AiSubtitleViewModel.SupportedLanguages}"
                                    SelectedValuePath="Code"
                                    SelectedValue="{Binding TargetLanguage}"
                                    DisplayMemberPath="DisplayName" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" IsEnabled="False">
                                <TextBlock
                                    Text="번역 엔진"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,4" />
                                <ComboBox
                                    ItemsSource="{x:Static local:AiSubtitleViewModel.EngineNames}"
                                    SelectedIndex="{Binding EngineIndex}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Text="번역 스타일"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Margin="0,0,0,4" />
                            <ComboBox
                                ItemsSource="{x:Static local:AiSubtitleViewModel.TranslationStyles}"
                                SelectedValuePath="Style"
                                SelectedValue="{Binding TranslationStyle}"
                                DisplayMemberPath="DisplayName" />
                        </StackPanel>

                    </StackPanel>
                </ui:CardExpander>

                <!-- ── 실행 버튼 ──────────────────────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        Content="🎬 자막 생성 시작"
                        FontSize="14"
                        Appearance="Primary"
                        HorizontalAlignment="Stretch"
                        Command="{Binding GenerateCommand}"
                        ToolTip="{Binding IsServerRunning,
                                  Converter={StaticResource BoolToVis},
                                  ConverterParameter='서버 연결 필요'}" />

                    <ui:Button
                        Grid.Column="2"
                        Content="취소"
                        Appearance="Caution"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- ── 진행률 ─────────────────────────────────────────── -->
                <StackPanel
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,12">
                    <TextBlock
                        Text="{Binding StageText}"
                        FontSize="13"
                        Margin="0,0,0,6"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar
                        Value="{Binding OverallProgress}"
                        Minimum="0"
                        Maximum="1"
                        Height="8" />
                </StackPanel>

                <!-- ── 결과 메시지 ────────────────────────────────────── -->
                <TextBlock
                    Text="{Binding ResultMessage}"
                    FontSize="13"
                    Foreground="{Binding ResultColor}"
                    Visibility="{Binding ResultMessage, Converter={StaticResource StrToVis}}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12" />

            </StackPanel>
        </ScrollViewer>

        <!-- ══ 하단: 로그 패널 (고정) ════════════════════════════════════ -->
        <Border
            Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}">

            <Grid Margin="12,6,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 로그 헤더 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="로그"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <ui:Button
                        Grid.Column="1"
                        Content="지우기"
                        Appearance="Transparent"
                        FontSize="11"
                        Padding="6,2"
                        Command="{Binding ClearLogsCommand}" />
                </Grid>

                <!-- 로그 목록 -->
                <ScrollViewer
                    Grid.Row="1"
                    x:Name="LogScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl
                        x:Name="LogItemsControl"
                        ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    FontFamily="Consolas, Courier New"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="NoWrap"
                                    Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</Page>
