<Page
    x:Class="fflux.UI.Modules.FFmpegExplorer.FFmpegExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:loc="clr-namespace:fflux.UI.Shared.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:fflux.UI.Modules.FFmpegExplorer"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:FFmpegExplorerViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="720"
    d:DesignWidth="960"
    Title="FFmpeg Explorer">

    <Page.Resources>
        <BooleanToVisibilityConverter             x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter    x:Key="InvBoolToVis" />

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"        Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize"          Value="13" />
            <Setter Property="Margin"            Value="0,0,12,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin"     Value="0,0,0,12" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="11" />
            <Setter Property="Foreground"  Value="{DynamicResource TextFillColorDisabledBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"      Value="0,4,0,0" />
        </Style>
        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- ① 파일 선택 -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:L FFmpegExplorer.Section.File}" />

                    <!-- 입력 파일 -->
                    <Grid Style="{StaticResource FormRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Input.Label}" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding InputFilePath, Mode=OneWay}" IsReadOnly="True" FontSize="12" Padding="8,6" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0"
                                   Command="{Binding BrowseInputCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L FFmpegExplorer.Input.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:L FFmpegExplorer.Input.Button}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- 출력 파일 -->
                    <Grid Style="{StaticResource FormRow}" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Output.Label}" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0"
                                   Command="{Binding BrowseOutputCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L FFmpegExplorer.Output.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:L FFmpegExplorer.Output.Button}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ② 옵션 탭 -->
            <TabControl Margin="0,0,0,12">

                <!-- 비디오 탭 -->
                <TabItem Header="{loc:L FFmpegExplorer.Tab.Video}">
                    <ui:Card Padding="16">
                        <StackPanel>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.VideoCodec.Label}" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static local:FFmpegExplorerViewModel.VideoCodecDisplayNames}"
                                          SelectedIndex="{Binding VideoCodecIndex, Mode=TwoWay}" FontSize="12" />
                            </Grid>

                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Quality.Label}" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,4,12,0" />
                                <StackPanel Grid.Column="1" IsEnabled="{Binding IsVideoEncodeEnabled}">
                                    <CheckBox Content="{loc:L FFmpegExplorer.Quality.UseCrf}"
                                              IsChecked="{Binding UseCrf, Mode=TwoWay}" FontSize="12" Margin="0,0,0,8" />
                                    <Grid Visibility="{Binding UseCrf, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="51"
                                                Value="{Binding CrfValue, Mode=TwoWay}"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CrfValue}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Visibility="{Binding UseCrf, Converter={StaticResource InvBoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding VideoBitrateText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6" />
                                        <TextBlock Grid.Column="1" Text="kbps" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Fps.Label}" Style="{StaticResource FormLabel}" />
                                <Grid Grid.Column="1" IsEnabled="{Binding IsVideoEncodeEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6" />
                                    <TextBlock Grid.Column="1" Text="fps" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Resolution.Label}" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static local:FFmpegExplorerViewModel.ResolutionDisplayNames}"
                                          SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding IsVideoEncodeEnabled}" FontSize="12" />
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}" Text="{loc:L FFmpegExplorer.Video.Hint}" />
                        </StackPanel>
                    </ui:Card>
                </TabItem>

                <!-- 오디오 탭 -->
                <TabItem Header="{loc:L FFmpegExplorer.Tab.Audio}">
                    <ui:Card Padding="16">
                        <StackPanel>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.AudioCodec.Label}" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static local:FFmpegExplorerViewModel.AudioCodecDisplayNames}"
                                          SelectedIndex="{Binding AudioCodecIndex, Mode=TwoWay}" FontSize="12" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Bitrate.Label}" Style="{StaticResource FormLabel}" />
                                <Grid Grid.Column="1" IsEnabled="{Binding IsAudioEncodeEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AudioBitrateText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6" />
                                    <TextBlock Grid.Column="1" Text="kbps" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.SampleRate.Label}" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static local:FFmpegExplorerViewModel.SampleRateDisplayNames}"
                                          SelectedIndex="{Binding SampleRateIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAudioEncodeEnabled}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L FFmpegExplorer.Channels.Label}" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static local:FFmpegExplorerViewModel.ChannelDisplayNames}"
                                          SelectedIndex="{Binding ChannelsIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAudioEncodeEnabled}" FontSize="12" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Text="{loc:L FFmpegExplorer.Audio.Hint}" />
                        </StackPanel>
                    </ui:Card>
                </TabItem>

                <!-- 필터 탭 -->
                <TabItem Header="{loc:L FFmpegExplorer.Tab.Filter}">
                    <ui:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:L FFmpegExplorer.VideoFilter.Label}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding VideoFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="8,8"
                                     MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16" Text="{loc:L FFmpegExplorer.VideoFilter.Hint}" />

                            <TextBlock Text="{loc:L FFmpegExplorer.AudioFilter.Label}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding AudioFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="8,8"
                                     MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" />
                            <TextBlock Style="{StaticResource HintText}" Text="{loc:L FFmpegExplorer.AudioFilter.Hint}" />
                        </StackPanel>
                    </ui:Card>
                </TabItem>

                <!-- 고급 탭 -->
                <TabItem Header="{loc:L FFmpegExplorer.Tab.Advanced}">
                    <ui:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:L FFmpegExplorer.ExtraArgs.Label}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ExtraArgsText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="8,8"
                                     MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{loc:L FFmpegExplorer.ExtraArgs.Hint}" />
                        </StackPanel>
                    </ui:Card>
                </TabItem>
            </TabControl>

            <!-- ③ 커맨드 미리보기 -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{loc:L FFmpegExplorer.Section.Command}"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,6,0"
                                       Command="{Binding CopyCommandCommand}" Appearance="Secondary"
                                       ToolTip="{loc:L FFmpegExplorer.Copy.Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:L FFmpegExplorer.Copy.Label}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Margin="0,0,6,0"
                                       Command="{Binding ExecuteCommand}" Appearance="Primary"
                                       ToolTip="{loc:L FFmpegExplorer.Execute.Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:L FFmpegExplorer.Execute.Label}" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding CancelCommand}" Appearance="Secondary"
                                       ToolTip="{loc:L FFmpegExplorer.Cancel.Tooltip}"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Stop24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:L FFmpegExplorer.Cancel.Label}" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding GeneratedCommand, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="12"
                             TextWrapping="Wrap" Padding="10,8"
                             VerticalScrollBarVisibility="Auto" MaxHeight="120" />
                </StackPanel>
            </ui:Card>

            <!-- ④ 실행 결과 / 로그 -->
            <ui:Card Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ProgressText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Height="5" Margin="0,0,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="11"
                             Padding="8,8" MinHeight="120" MaxHeight="300"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
