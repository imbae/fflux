<UserControl
    x:Class="fflux.UI.Modules.Player.MediaInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:si="clr-namespace:fflux.Core.Models.StreamInfo;assembly=fflux.Core"
    mc:Ignorable="d"
    Width="270"
    IsHitTestVisible="True">

    <!--
        DataContext = PlayerViewModel (페이지에서 DataContext 상속).
        정적 미디어 정보는 CurrentMediaInfo.* 경로로, 실시간 통계는 직접 바인딩합니다.
    -->

    <UserControl.Resources>

        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter  x:Key="BoolToVis" />

        <!-- 섹션 헤더 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF7C5CBF" />
            <Setter Property="Margin"     Value="10,8,10,4" />
        </Style>

        <!-- 서브 헤더 (스트림 인덱스 등) -->
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FF8898B0" />
            <Setter Property="Margin"     Value="10,6,10,2" />
        </Style>

        <!-- 구분선 -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height"     Value="1" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Margin"     Value="10,4" />
        </Style>

        <!-- 키 텍스트 (좌측, 고정 너비) -->
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="#FF9C9CAA" />
            <Setter Property="Width"      Value="72" />
            <Setter Property="Margin"     Value="10,1,4,1" />
        </Style>

        <!-- 값 텍스트 (우측, Consolas) -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="FontFamily"   Value="Consolas, Courier New" />
            <Setter Property="Foreground"   Value="#FFDDDDE8" />
            <Setter Property="Margin"       Value="0,1,10,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 실시간 값 텍스트 (강조색) -->
        <Style x:Key="LiveValueText" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="Foreground" Value="#FF00E040" />
        </Style>

        <!-- 비디오 스트림 DataTemplate -->
        <DataTemplate x:Key="VideoStreamTemplate" DataType="{x:Type si:VideoStreamInfo}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SubHeader}"
                    Text="{Binding StreamIndex, StringFormat='스트림 #{0}'}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="코덱" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding CodecName}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Visibility="{Binding Profile, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Style="{StaticResource KeyText}" Text="프로파일" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding Profile}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="해상도" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding ResolutionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="기준 FPS" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding FrameRateText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="픽셀 포맷" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding PixelFormat}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="비트레이트" />
                    <TextBlock
                        Style="{StaticResource ValueText}"
                        Text="{Binding BitRateMbps, StringFormat='{}{0:F2} Mbps',
                                       TargetNullValue='—'}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 오디오 스트림 DataTemplate -->
        <DataTemplate x:Key="AudioStreamTemplate" DataType="{x:Type si:AudioStreamInfo}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SubHeader}"
                    Text="{Binding StreamIndex, StringFormat='스트림 #{0}'}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="코덱" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding CodecName}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="샘플레이트" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding SampleRateText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="채널" />
                    <TextBlock
                        Style="{StaticResource ValueText}"
                        Text="{Binding ChannelLayout, TargetNullValue='—'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource KeyText}" Text="비트레이트" />
                    <TextBlock
                        Style="{StaticResource ValueText}"
                        Text="{Binding BitRateText, TargetNullValue='—'}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Visibility="{Binding Language, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Style="{StaticResource KeyText}" Text="언어" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding Language}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Border
        Background="#E60D0B14"
        BorderBrush="#33FFFFFF"
        BorderThickness="0,0,0,0"
        CornerRadius="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══ 타이틀바 ════════════════════════════════════════════ -->
            <Border
                Grid.Row="0"
                Background="#CC1A0F2E"
                BorderBrush="#44FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="미디어 정보"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFB89AEF"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding CurrentMediaInfo.FileName}"
                        FontSize="10"
                        FontFamily="Consolas"
                        Foreground="#FF7C7C8F"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="140" />
                </StackPanel>
            </Border>

            <!-- ══ 스크롤 컨텐츠 ══════════════════════════════════════ -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="0,0,0,8">

                    <!-- ─── 현재 재생 (실시간 통계) — IsFileOpen 일 때만 표시 ─── -->
                    <StackPanel
                        Visibility="{Binding IsFileOpen, Converter={StaticResource BoolToVis}}">

                        <TextBlock Style="{StaticResource SectionHeader}" Text="▶ 현재 재생" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="FPS" />
                            <TextBlock
                                Style="{StaticResource LiveValueText}"
                                Text="{Binding CurrentFps, StringFormat='{}{0:F1}'}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="비트레이트" />
                            <TextBlock
                                Style="{StaticResource LiveValueText}"
                                Text="{Binding CurrentBitrateKbps, StringFormat='{}{0:F0} Kbps'}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="프레임 번호" />
                            <TextBlock
                                Style="{StaticResource LiveValueText}"
                                Text="{Binding CurrentFrameNumber, StringFormat='#{0:N0}'}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                    </StackPanel>

                    <!-- ─── 컨테이너 — CurrentMediaInfo != null 일 때만 표시 ─── -->
                    <StackPanel
                        Visibility="{Binding CurrentMediaInfo,
                                     Converter={StaticResource NullToCollapsed}}">

                        <TextBlock Style="{StaticResource SectionHeader}" Text="📦 컨테이너" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="형식" />
                            <TextBlock
                                Style="{StaticResource ValueText}"
                                Text="{Binding CurrentMediaInfo.FormatLongName, TargetNullValue='—'}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="길이" />
                            <TextBlock
                                Style="{StaticResource ValueText}"
                                Text="{Binding CurrentMediaInfo.DurationText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="파일 크기" />
                            <TextBlock
                                Style="{StaticResource ValueText}"
                                Text="{Binding CurrentMediaInfo.FileSizeText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource KeyText}" Text="비트레이트" />
                            <TextBlock
                                Style="{StaticResource ValueText}"
                                Text="{Binding CurrentMediaInfo.BitRateText, TargetNullValue='—'}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- ─── 비디오 스트림 ─── -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🎬 비디오" />

                        <ItemsControl
                            ItemsSource="{Binding CurrentMediaInfo.VideoStreams}"
                            ItemTemplate="{StaticResource VideoStreamTemplate}" />

                        <TextBlock Text="스트림 없음">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeader}">
                                    <Setter Property="Foreground" Value="#FF666680" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CurrentMediaInfo.VideoStreams.Count}"
                                            Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource Divider}" />

                        <!-- ─── 오디오 스트림 ─── -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="🔊 오디오" />

                        <ItemsControl
                            ItemsSource="{Binding CurrentMediaInfo.AudioStreams}"
                            ItemTemplate="{StaticResource AudioStreamTemplate}" />

                        <TextBlock Text="스트림 없음">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeader}">
                                    <Setter Property="Foreground" Value="#FF666680" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CurrentMediaInfo.AudioStreams.Count}"
                                            Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <!-- 파일 미열기 힌트 -->
                    <TextBlock
                        Text="파일을 열면 정보가 표시됩니다"
                        FontSize="11"
                        Foreground="#FF555570"
                        Margin="10,12,10,0"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsFileOpen,
                                     Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFileOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
