<Page
    x:Class="fflux.UI.Modules.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:ctrl="clr-namespace:fflux.UI.Shared.Controls"
    xmlns:misb="clr-namespace:fflux.UI.Modules.MisbViewer"
    xmlns:loc="clr-namespace:fflux.UI.Shared.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:fflux.UI.Modules.Player"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:PlayerViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    Title="Player"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Page.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <BooleanToVisibilityConverter          x:Key="BoolToVis" />

        <Style x:Key="FrameStepStyle" TargetType="RepeatButton">
            <Setter Property="Background"        Value="Transparent" />
            <Setter Property="BorderThickness"   Value="0" />
            <Setter Property="Padding"           Value="0" />
            <Setter Property="Width"             Value="32" />
            <Setter Property="Height"            Value="32" />
            <Setter Property="Cursor"            Value="Hand" />
            <Setter Property="Foreground"        Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Delay"             Value="400" />
            <Setter Property="Interval"          Value="80" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtnStyle" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width"   Value="32" />
            <Setter Property="Height"  Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Secondary" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Background="Black"
        Focusable="True"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseLeave="OnMouseLeave"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        ClipToBounds="True">

        <!-- 비디오 이미지 -->
        <Border AllowDrop="True" Drop="OnVideoDrop" DragOver="OnVideoDragOver">
            <Image Source="{Binding VideoBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
        </Border>

        <!-- MISB VMTI 오버레이 -->
        <misb:MisbOverlayControl Visibility="{Binding IsMisbEnabled, Converter={StaticResource BoolToVis}}" />

        <!-- MISB 상태 배지 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0"
                Background="#CC1A1428" CornerRadius="4" Padding="7,3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMisbEnabled}" Value="True" />
                                <Condition Binding="{Binding IsMisbLoaded}"  Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Location24" FontSize="11" Foreground="#FF00E040" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MisbStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF00E040" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 파일 미열기 드롭 힌트 -->
        <Grid IsHitTestVisible="False" Visibility="{Binding IsFileOpen, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="FolderOpen28" FontSize="56"
                               Foreground="{DynamicResource FFluxSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:L Player.Hint.OpenFile}" FontSize="14" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:L Player.Hint.Formats}" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:L Player.Hint.Streaming}" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- LIVE 배지 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,12,0,0"
                Background="#CCDD2222" CornerRadius="4" Padding="7,3"
                Visibility="{Binding IsLiveStream, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="● LIVE" FontSize="12" FontWeight="SemiBold" Foreground="White" />
        </Border>

        <!-- 녹화 중 배지 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,48,0,0"
                Background="#CC991111" CornerRadius="4" Padding="7,3"
                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding RecordingDurationText}" FontSize="12" FontWeight="SemiBold"
                       FontFamily="Consolas, Courier New" Foreground="White" />
        </Border>

        <!-- 우측 패널 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,0,0,80">
            <local:MediaInfoPanel Visibility="{Binding IsMediaInfoVisible, Converter={StaticResource BoolToVis}}" />
            <misb:MisbMetadataPanel x:Name="MisbPanel"
                DataContext="{Binding MisbDisplay}"
                Visibility="{Binding DataContext.IsMisbPanelVisible, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 자막 오버레이 -->
        <ctrl:SubtitleOverlayControl
            SubtitleText="{Binding SubtitleText}"
            SubtitleFontSize="{Binding SubtitleFontSize}"
            SubtitleColor="{Binding SubtitleColor}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="80,0,80,116"
            Visibility="{Binding IsSubtitleVisible, Converter={StaticResource BoolToVis}}" />
        <ctrl:SubtitleOverlayControl
            SubtitleText="{Binding RealTimeTranslationText}"
            SubtitleFontSize="{Binding SubtitleFontSize}"
            SubtitleColor="LightYellow"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="80,0,80,80"
            Visibility="{Binding IsRealTimeTranslationEnabled, Converter={StaticResource BoolToVis}}" />

        <!-- 하단 컨트롤 바 -->
        <Border x:Name="ControlBar" VerticalAlignment="Bottom" Padding="12,10,12,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent"  Offset="0.0" />
                    <GradientStop Color="#BB1A1428"    Offset="0.4" />
                    <GradientStop Color="#F51A1428"    Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: PRO 툴바 -->
                <Border Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,6"
                        BorderBrush="#33FFB300" BorderThickness="0,0,0,1" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- PRO 뱃지 -->
                        <Border Background="#FFB300" CornerRadius="3" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#1A0A00" />
                        </Border>

                        <!-- MISB KLV -->
                        <Grid Margin="0,0,4,0">
                            <ui:Button Height="32" IsEnabled="{Binding IsPremiumUser}"
                                       Command="{Binding ToggleMisbCommand}"
                                       ToolTip="{loc:L Player.Misb.Tooltip}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMisbEnabled}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Location24" FontSize="12" Margin="0,0,4,0" />
                                    <TextBlock Text="MISB KLV" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="#CC100C1C" CornerRadius="3" Padding="2,1" Margin="0,0,-3,-3"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsPremiumUser, Converter={StaticResource InvBoolToVis}}">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="8" Foreground="#FFB300" />
                            </Border>
                        </Grid>

                        <!-- 메타데이터 패널 -->
                        <Grid Margin="0,0,4,0">
                            <ui:Button Height="32" IsEnabled="{Binding IsPremiumUser}"
                                       Command="{Binding ToggleMisbPanelCommand}"
                                       ToolTip="{loc:L Player.MisbPanel.Tooltip}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMisbPanelVisible}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SlideText24" FontSize="12" Margin="0,0,4,0" />
                                    <TextBlock Text="{loc:L Player.MisbPanel.Label}" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="#CC100C1C" CornerRadius="3" Padding="2,1" Margin="0,0,-3,-3"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsPremiumUser, Converter={StaticResource InvBoolToVis}}">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="8" Foreground="#FFB300" />
                            </Border>
                        </Grid>

                        <!-- 실시간 AI 번역 -->
                        <Grid Margin="0,0,0,0">
                            <ui:Button Height="32" IsEnabled="{Binding IsPremiumUser}"
                                       Command="{Binding ToggleRealTimeTranslationCommand}"
                                       ToolTip="{loc:L Player.RealTime.Tooltip}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRealTimeTranslationEnabled}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Translate24" FontSize="12" Margin="0,0,4,0" />
                                    <TextBlock Text="{loc:L Player.RealTime.Label}" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="#CC100C1C" CornerRadius="3" Padding="2,1" Margin="0,0,-3,-3"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsPremiumUser, Converter={StaticResource InvBoolToVis}}">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="8" Foreground="#FFB300" />
                            </Border>
                        </Grid>

                        <TextBlock Margin="10,0"
                                   Text="{loc:L Player.Pro.Notice}"
                                   FontSize="13"
                                   Foreground="Goldenrod"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Row 1: 시크 슬라이더 -->
                <Slider Grid.Row="1" Margin="0,0,0,6"
                        Minimum="0" Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        IsEnabled="{Binding CanSeek}"
                        TickFrequency="1" SmallChange="1" LargeChange="10" />

                <!-- Row 2: 트랜스포트 행 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 재생 제어 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <RepeatButton Margin="0,0,2,0" Style="{StaticResource FrameStepStyle}"
                                      Command="{Binding StepFrameBackwardCommand}"
                                      ToolTip="{loc:L Player.FrameBack.Tooltip}">
                            <ui:SymbolIcon Symbol="PreviousFrame24" FontSize="14" />
                        </RepeatButton>

                        <ui:Button Width="40" Height="36" Margin="0,0,2,0" ToolTip="{loc:L Player.Play.Tooltip}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Command"    Value="{Binding PlayCommand}" />
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Command"    Value="{Binding PauseCommand}" />
                                            <Setter Property="Appearance" Value="Secondary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Symbol" Value="Pause24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                        <ui:Button Width="36" Height="36" Margin="0,0,2,0"
                                   Command="{Binding StopCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L Player.Stop.Tooltip}">
                            <ui:SymbolIcon Symbol="Stop24" FontSize="14" />
                        </ui:Button>

                        <RepeatButton Style="{StaticResource FrameStepStyle}"
                                      Command="{Binding StepFrameForwardCommand}"
                                      ToolTip="{loc:L Player.FrameForward.Tooltip}">
                            <ui:SymbolIcon Symbol="NextFrame24" FontSize="14" />
                        </RepeatButton>

                        <Border Width="1" Height="18" Background="#44FFFFFF" Margin="8,0" VerticalAlignment="Center" />

                        <!-- 열기 -->
                        <ui:Button Margin="0,0,3,0" Height="32"
                                   Command="{Binding OpenFileCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L Player.Open.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="{loc:L Player.Open.Label}" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <!-- 스트리밍 -->
                        <ui:Button Margin="0,0,3,0" Height="32"
                                   Command="{Binding OpenStreamCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L Player.Stream.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stream24" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="{loc:L Player.Stream.Label}" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <!-- 자막 열기 -->
                        <ui:Button Height="32"
                                   Command="{Binding LoadSubtitleCommand}" Appearance="Secondary"
                                   ToolTip="{loc:L Player.LoadSubtitle.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Subtitles24" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="{loc:L Player.LoadSubtitle.Label}" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <Border Width="1" Height="18" Background="#44FFFFFF" Margin="8,0" VerticalAlignment="Center" />

                        <!-- 녹화 -->
                        <Grid Margin="0,0,4,0">
                            <ui:Button Height="32"
                                       Command="{Binding ToggleRecordingCommand}"
                                       IsEnabled="{Binding IsFileOpen}"
                                       ToolTip="{loc:L Player.Record.Tooltip}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Appearance" Value="Danger" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="12" Margin="0,0,4,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Record24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Symbol" Value="Stop24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{loc:L Player.Record.Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Text" Value="{loc:L Player.Record.Stop}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <!-- GIF -->
                        <Grid Margin="0,0,4,0">
                            <ui:Button Height="32"
                                       Command="{Binding ExportGifCommand}"
                                       IsEnabled="{Binding CanSeek}" Appearance="Secondary"
                                       ToolTip="{loc:L Player.Gif.Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ImageAltText24" FontSize="12" Margin="0,0,4,0" />
                                    <TextBlock Text="GIF" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <!-- 자막 토글 -->
                        <ui:Button Margin="0,0,3,0" ToolTip="{loc:L Player.Subtitle.Tooltip}"
                                   Command="{Binding ToggleSubtitleCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubtitleVisible}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon Symbol="Subtitles24" FontSize="14" />
                        </ui:Button>

                        <!-- 미디어 정보 토글 -->
                        <ui:Button Margin="0,0,4,0" ToolTip="{loc:L Player.MediaInfo.Tooltip}"
                                   Command="{Binding ToggleMediaInfoCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarBtnStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMediaInfoVisible}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" />
                        </ui:Button>

                    </StackPanel>

                    <!-- 중앙: 상태 텍스트 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- 우측: 볼륨 · 속도 · 타임코드 · 풀스크린 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <ui:Button Margin="0,0,3,0" Width="32" Height="32"
                                   Command="{Binding ToggleMuteCommand}" Appearance="Transparent"
                                   ToolTip="{loc:L Player.Mute.Tooltip}">
                            <ui:SymbolIcon Margin="-10" FontSize="14" Symbol="{Binding VolumeSymbol}" />
                        </ui:Button>

                        <Slider Width="80" Margin="10,0" Minimum="0" Maximum="100"
                                Value="{Binding VolumeLevel, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip="{Binding VolumeLevel, StringFormat='{}{0:F0}'}" />

                        <TextBlock Text="{loc:L Player.Speed.Label}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ComboBox Width="80" Margin="10,0"
                                  SelectedIndex="{Binding SelectedSpeedIndex, Mode=TwoWay}"
                                  VerticalAlignment="Center" FontSize="12"
                                  ToolTip="{loc:L Player.Speed.Tooltip}">
                            <ComboBoxItem>0.25×</ComboBoxItem>
                            <ComboBoxItem>0.5×</ComboBoxItem>
                            <ComboBoxItem>0.75×</ComboBoxItem>
                            <ComboBoxItem>1×</ComboBoxItem>
                            <ComboBoxItem>1.25×</ComboBoxItem>
                            <ComboBoxItem>1.5×</ComboBoxItem>
                            <ComboBoxItem>2×</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Margin="0,0,6,0"
                                   Text="{Binding TimecodeText}"
                                   FontSize="12" VerticalAlignment="Center"
                                   FontFamily="Consolas, Courier New"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:Button Width="36" Height="32"
                                   Command="{Binding ToggleFullscreenCommand}" Appearance="Transparent"
                                   ToolTip="{loc:L Player.Fullscreen.Tooltip}">
                            <ui:SymbolIcon FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="FullScreenMaximize24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                <Setter Property="Symbol" Value="FullScreenMinimize24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Page>
