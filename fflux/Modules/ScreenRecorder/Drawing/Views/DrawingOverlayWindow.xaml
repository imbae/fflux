<Window
    x:Class="fflux.UI.Modules.ScreenRecorder.Drawing.Views.DrawingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    IsHitTestVisible="False"
    Left="0" Top="0"
    Title="fflux Drawing Overlay">

    <!--
        이 창은 WS_EX_TRANSPARENT 상태로 항상 클릭 통과.
        마우스 이벤트는 GlobalMouseHook(중간 버튼)으로 수신.
        렌더링 전용이므로 IsHitTestVisible=False.
    -->
    <Canvas x:Name="DrawingCanvas" Background="Transparent" IsHitTestVisible="False" />

</Window>
