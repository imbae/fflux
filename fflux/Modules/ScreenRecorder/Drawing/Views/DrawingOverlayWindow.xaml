<Window
    x:Class="fflux.UI.Modules.ScreenRecorder.Drawing.Views.DrawingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:fflux.UI.Modules.ScreenRecorder.Drawing.Views"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    Left="0" Top="0"
    Title="fflux Drawing Overlay">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ToggleClickThroughCommand}" />
        <KeyBinding Key="Escape"             Command="{Binding ToggleClickThroughCommand}" />
    </Window.InputBindings>

    <Grid>

        <!-- 그리기 영역 -->
        <Grid x:Name="DrawingArea">
            <!-- 펜: InkCanvas (아래 레이어) -->
            <InkCanvas
                x:Name="InkLayer"
                Background="Transparent"
                EditingMode="Ink" />

            <!-- 도형/텍스트: Canvas (위 레이어, 마우스 이벤트 수신) -->
            <Canvas
                x:Name="ShapeLayer"
                Background="Transparent"
                MouseLeftButtonDown="OnShapeMouseDown"
                MouseMove="OnShapeMouseMove"
                MouseLeftButtonUp="OnShapeMouseUp" />
        </Grid>

        <!-- 툴바 (상단 중앙, 항상 최상위) -->
        <local:DrawingToolbarView
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Panel.ZIndex="100"
            MouseLeftButtonDown="OnToolbarDragMove" />

    </Grid>
</Window>
