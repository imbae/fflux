<UserControl
    x:Class="fflux.UI.Modules.ScreenRecorder.Drawing.Views.DrawingToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:fflux.UI.Modules.ScreenRecorder.Drawing">

    <UserControl.Resources>

        <!-- 도구 선택 ToggleButton — 커스텀 템플릿으로 아이콘 클리핑 방지 -->
        <Style x:Key="DrawToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="FontSize"         Value="15"/>
            <Setter Property="FontFamily"       Value="Segoe UI Symbol"/>
            <Setter Property="Width"            Value="32"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Margin"           Value="1,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="2,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#553388EE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3388EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#33FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#664499FF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 액션 Button (Undo/Redo/Clear/굵기 등) — 클리핑 방지 -->
        <Style x:Key="DrawToolButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontFamily"      Value="Segoe UI Emoji"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="2,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border
        Background="#DD111111"
        CornerRadius="10"
        Padding="10,6">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- ── 도구 선택 ─────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    ToolTip="펜 (P)"
                    IsChecked="{Binding IsToolPen, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Pen">
                    <TextBlock Text="✏" FontFamily="Segoe UI Emoji" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    Content="▭" ToolTip="사각형 (R)"
                    IsChecked="{Binding IsToolRectangle, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Rectangle"/>

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    Content="○" ToolTip="원 (E)"
                    IsChecked="{Binding IsToolEllipse, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Ellipse"/>

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    Content="╱" ToolTip="선 (L)"
                    IsChecked="{Binding IsToolLine, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Line"/>

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    Content="→" ToolTip="화살표 (A)"
                    IsChecked="{Binding IsToolArrow, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Arrow"/>

                <ToggleButton
                    Style="{StaticResource DrawToolToggleStyle}"
                    Content="T" ToolTip="텍스트 (T)"
                    FontFamily="Segoe UI"
                    IsChecked="{Binding IsToolText, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Text"/>

            </StackPanel>

            <Separator Width="1" Height="22" Margin="4,0" Background="#555" VerticalAlignment="Center"/>

            <!-- ── 색상 프리셋 ──────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">

                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Width="20" Height="20" Margin="2,0"
                    Background="#FF4444"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FF4444"
                    ToolTip="빨강" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Width="20" Height="20" Margin="2,0"
                    Background="#FFDD00"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FFDD00"
                    ToolTip="노랑" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Width="20" Height="20" Margin="2,0"
                    Background="#44DD44"
                    Command="{Binding SelectColorCommand}" CommandParameter="#44DD44"
                    ToolTip="초록" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Width="20" Height="20" Margin="2,0"
                    Background="#4488FF"
                    Command="{Binding SelectColorCommand}" CommandParameter="#4488FF"
                    ToolTip="파랑" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Width="20" Height="20" Margin="2,0"
                    Background="White"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FFFFFF"
                    ToolTip="흰색" />

                <!-- 현재 색상 표시 -->
                <Border
                    Width="20" Height="20" Margin="4,0,0,0"
                    CornerRadius="4" BorderThickness="2" BorderBrush="#888">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding SelectedColor}" />
                    </Border.Background>
                </Border>

            </StackPanel>

            <Separator Width="1" Height="22" Margin="4,0" Background="#555" VerticalAlignment="Center"/>

            <!-- ── 굵기 ──────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Button Style="{StaticResource DrawToolButtonStyle}"
                        Content="1" Width="26" Height="26" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="1"
                        ToolTip="굵기 1" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                        Content="3" Width="26" Height="26" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="3"
                        ToolTip="굵기 3" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                        Content="5" Width="26" Height="26" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="5"
                        ToolTip="굵기 5" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                        Content="8" Width="26" Height="26" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="8"
                        ToolTip="굵기 8" />
            </StackPanel>

            <Separator Width="1" Height="22" Margin="4,0" Background="#555" VerticalAlignment="Center"/>

            <!-- ── Undo / Redo / Clear ───────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Content="↩" Width="30" Height="30" Margin="1,0"
                    Command="{Binding UndoCommand}"
                    ToolTip="실행 취소 (Ctrl+Z)" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Content="↪" Width="30" Height="30" Margin="1,0"
                    Command="{Binding RedoCommand}"
                    ToolTip="다시 실행 (Ctrl+Y)" />
                <Button Style="{StaticResource DrawToolButtonStyle}"
                    Content="🗑" Width="30" Height="30" Margin="1,0"
                    Command="{Binding ClearCommand}"
                    ToolTip="모두 지우기" />
            </StackPanel>


        </StackPanel>
    </Border>
</UserControl>
