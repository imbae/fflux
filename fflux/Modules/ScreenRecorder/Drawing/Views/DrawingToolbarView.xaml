<UserControl
    x:Class="fflux.UI.Modules.ScreenRecorder.Drawing.Views.DrawingToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:fflux.UI.Modules.ScreenRecorder.Drawing">

    <Border
        Background="#DD111111"
        CornerRadius="10"
        Padding="10,6">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- ── 도구 선택 ─────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">

                <ToggleButton
                    Content="✏" ToolTip="펜 (P)"
                    IsChecked="{Binding IsToolPen, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Pen"
                    Style="{StaticResource {x:Type ToggleButton}}"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

                <ToggleButton
                    Content="▭" ToolTip="사각형 (R)"
                    IsChecked="{Binding IsToolRectangle, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Rectangle"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

                <ToggleButton
                    Content="○" ToolTip="원 (E)"
                    IsChecked="{Binding IsToolEllipse, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Ellipse"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

                <ToggleButton
                    Content="╱" ToolTip="선 (L)"
                    IsChecked="{Binding IsToolLine, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Line"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

                <ToggleButton
                    Content="→" ToolTip="화살표 (A)"
                    IsChecked="{Binding IsToolArrow, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Arrow"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

                <ToggleButton
                    Content="T" ToolTip="텍스트 (T)"
                    IsChecked="{Binding IsToolText, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="Text"
                    Foreground="White" Background="Transparent"
                    Width="30" Height="28" Margin="1,0" />

            </StackPanel>

            <Separator Style="{StaticResource {x:Type Separator}}" Width="1" Height="22" Margin="4,0" Background="#555" />

            <!-- ── 색상 프리셋 ──────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">

                <Button
                    Width="20" Height="20" Margin="2,0"
                    Background="#FF4444" BorderThickness="0"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FF4444"
                    ToolTip="빨강" />
                <Button
                    Width="20" Height="20" Margin="2,0"
                    Background="#FFDD00" BorderThickness="0"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FFDD00"
                    ToolTip="노랑" />
                <Button
                    Width="20" Height="20" Margin="2,0"
                    Background="#44DD44" BorderThickness="0"
                    Command="{Binding SelectColorCommand}" CommandParameter="#44DD44"
                    ToolTip="초록" />
                <Button
                    Width="20" Height="20" Margin="2,0"
                    Background="#4488FF" BorderThickness="0"
                    Command="{Binding SelectColorCommand}" CommandParameter="#4488FF"
                    ToolTip="파랑" />
                <Button
                    Width="20" Height="20" Margin="2,0"
                    Background="White" BorderThickness="0"
                    Command="{Binding SelectColorCommand}" CommandParameter="#FFFFFF"
                    ToolTip="흰색" />

                <!-- 현재 색상 표시 -->
                <Border
                    Width="20" Height="20" Margin="4,0,0,0"
                    CornerRadius="4" BorderThickness="2" BorderBrush="#888">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding SelectedColor}" />
                    </Border.Background>
                </Border>

            </StackPanel>

            <Separator Style="{StaticResource {x:Type Separator}}" Width="1" Height="22" Margin="4,0" Background="#555" />

            <!-- ── 굵기 ──────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Button Content="1" Width="24" Height="24" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="1"
                        Foreground="White" Background="Transparent" ToolTip="굵기 1" />
                <Button Content="3" Width="24" Height="24" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="3"
                        Foreground="White" Background="Transparent" ToolTip="굵기 3" />
                <Button Content="5" Width="24" Height="24" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="5"
                        Foreground="White" Background="Transparent" ToolTip="굵기 5" />
                <Button Content="8" Width="24" Height="24" Margin="1,0"
                        Command="{Binding SelectThicknessCommand}" CommandParameter="8"
                        Foreground="White" Background="Transparent" ToolTip="굵기 8" />
            </StackPanel>

            <Separator Style="{StaticResource {x:Type Separator}}" Width="1" Height="22" Margin="4,0" Background="#555" />

            <!-- ── Undo / Redo / Clear ───────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Button
                    Content="↩" Width="28" Height="28" Margin="1,0"
                    Command="{Binding UndoCommand}"
                    Foreground="White" Background="Transparent"
                    ToolTip="실행 취소 (Ctrl+Z)" />
                <Button
                    Content="↪" Width="28" Height="28" Margin="1,0"
                    Command="{Binding RedoCommand}"
                    Foreground="White" Background="Transparent"
                    ToolTip="다시 실행 (Ctrl+Y)" />
                <Button
                    Content="🗑" Width="28" Height="28" Margin="1,0"
                    Command="{Binding ClearCommand}"
                    Foreground="White" Background="Transparent"
                    ToolTip="모두 지우기" />
            </StackPanel>

            <Separator Style="{StaticResource {x:Type Separator}}" Width="1" Height="22" Margin="4,0" Background="#555" />

            <!-- ── 클릭 통과 토글 ────────────────────────────── -->
            <Button
                Width="60" Height="28"
                Command="{Binding ToggleClickThroughCommand}"
                Foreground="White" Background="Transparent"
                ToolTip="클릭 통과 ON/OFF (Ctrl+D)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="✏ 그리기" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                <Setter Property="Content" Value="🖱 통과" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Border>
</UserControl>
