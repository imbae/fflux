<Page
    x:Class="fflux.UI.Modules.ScreenRecorder.ScreenRecorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:fflux.UI.Modules.ScreenRecorder"
    Title="Screen Recorder">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="680" HorizontalAlignment="Left">

            <!-- ══ 헤더 ═══════════════════════════════════════════════ -->
            <TextBlock
                Text="Screen Recorder"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,4" />
            <TextBlock
                Text="DXGI Desktop Duplication 기반 고성능 화면 캡처"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,24" />

            <!-- ══ 캡처 대상 ══════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock
                        Text="캡처 대상"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12" />

                    <WrapPanel>
                        <RadioButton
                            Content="전체 화면"
                            IsChecked="{Binding IsFullScreenMode}"
                            GroupName="CaptureMode"
                            Margin="0,0,20,0" />
                        <RadioButton
                            Content="영역 선택"
                            IsChecked="{Binding IsRegionMode}"
                            GroupName="CaptureMode"
                            Margin="0,0,20,0" />
                        <RadioButton
                            Content="특정 윈도우"
                            IsChecked="{Binding IsWindowMode}"
                            GroupName="CaptureMode" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- ══ 모니터 선택 ════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,12"
                     IsEnabled="{Binding IsFullScreenMode}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Text="모니터 선택"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />
                        <ComboBox
                            ItemsSource="{Binding Monitors}"
                            SelectedItem="{Binding SelectedMonitor}"
                            DisplayMemberPath="DisplayName"
                            MinWidth="320" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        Content="새로고침"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding LoadMonitorsCommand}"
                        Appearance="Secondary"
                        VerticalAlignment="Bottom"
                        Margin="12,0,0,0" />
                </Grid>
            </ui:Card>

            <!-- ══ 오디오 설정 ════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock
                        Text="오디오"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12" />

                    <WrapPanel>
                        <CheckBox
                            Content="시스템 사운드"
                            IsChecked="{Binding RecordSystemAudio}"
                            Margin="0,0,24,0" />
                        <CheckBox
                            Content="마이크"
                            IsChecked="{Binding RecordMicrophone}" />
                    </WrapPanel>

                    <TextBlock
                        Text="오디오 캡처는 Phase 10 녹화 파이프라인 완성 후 동작합니다."
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- ══ FPS ════════════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="목표 FPS"
                            FontSize="13"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            VerticalAlignment="Center">
                            <Run Text="{Binding TargetFps, Mode=OneWay}" />
                            <Run Text=" fps" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" FontWeight="Normal" />
                        </TextBlock>
                    </Grid>

                    <Slider
                        Minimum="1"
                        Maximum="60"
                        Value="{Binding TargetFps}"
                        SmallChange="1"
                        LargeChange="15"
                        TickPlacement="BottomRight"
                        TickFrequency="15"
                        IsSnapToTickEnabled="False" />

                    <WrapPanel Margin="0,4,0,0">
                        <ui:Button Content="15" Appearance="Secondary" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding SetFpsCommand}" CommandParameter="15" />
                        <ui:Button Content="30" Appearance="Secondary" Padding="10,4" Margin="0,0,6,0"
                                   Command="{Binding SetFpsCommand}" CommandParameter="30" />
                        <ui:Button Content="60" Appearance="Secondary" Padding="10,4"
                                   Command="{Binding SetFpsCommand}" CommandParameter="60" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- ══ 출력 경로 ══════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock
                        Text="출력 경로"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="True"
                            Margin="0,0,8,0" />

                        <ui:Button
                            Grid.Column="1"
                            Content="폴더 선택"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding SelectOutputDirectoryCommand}"
                            Appearance="Secondary" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ══ 핫키 안내 ══════════════════════════════════════════ -->
            <ui:Card Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock
                        Text="단축키"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,2" Margin="0,0,10,6">
                            <TextBlock Text="F9" FontFamily="Consolas" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="캡처 시작 / 정지"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,20,6" />

                        <Border Grid.Column="2" Grid.Row="0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,2" Margin="0,0,10,6">
                            <TextBlock Text="F10" FontFamily="Consolas" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="3" Grid.Row="0"
                                   Text="일시정지 / 재개"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,6" />

                        <Border Grid.Column="0" Grid.Row="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="F11" FontFamily="Consolas" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="1" Grid.Row="1"
                                   Text="단일 프레임 저장"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ══ 상태 표시 ══════════════════════════════════════════ -->
            <Border
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,16"
                Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 녹화 중 펄스 인디케이터 -->
                    <Ellipse
                        Grid.Column="0"
                        Width="10" Height="10"
                        Fill="#FF4444"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="1" To="0.2" Duration="0:0:0.8"
                                            AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusText}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- ══ 캡처 토글 버튼 ════════════════════════════════════ -->
            <ui:Button
                Command="{Binding ToggleCaptureCommand}"
                HorizontalAlignment="Stretch"
                Height="44"
                FontSize="14"
                FontWeight="SemiBold">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Content" Value="● 캡처 시작" />
                        <Setter Property="Appearance" Value="Primary" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Content" Value="■ 캡처 중지" />
                                <Setter Property="Appearance" Value="Danger" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

        </StackPanel>
    </ScrollViewer>

</Page>
