<Window x:Class="fflux.UI.Modules.ScreenRecorder.Views.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Cursor="Cross"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Canvas x:Name="RootCanvas"
            Background="#AA000000"
            MouseLeftButtonDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp">

        <!-- 선택 영역 표시 사각형 -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF00AAFF"
                   StrokeThickness="2"
                   Fill="#2200AAFF"
                   Visibility="Collapsed" />

        <!-- 안내 텍스트 -->
        <Border x:Name="HintBorder"
                Background="#BB000000"
                CornerRadius="8"
                Padding="20,10">
            <TextBlock Text="드래그하여 캡처 영역을 선택하세요     ESC 취소"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold" />
        </Border>

    </Canvas>
</Window>
