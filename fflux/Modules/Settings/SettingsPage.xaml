<Page
    x:Class="fflux.UI.Modules.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:fflux.UI.Modules.Settings"
    xmlns:loc="clr-namespace:fflux.UI.Shared.Services"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="2500"
    d:DesignWidth="900"
    Title="Settings">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="32,24,32,32"
            MaxWidth="760">

            <!-- ── 페이지 헤더 ──────────────────────────────── -->
            <TextBlock
                Text="{loc:L Settings.Title}"
                FontSize="28"
                FontWeight="SemiBold"
                Margin="0,0,0,24"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- ══ Card: FFmpeg 설정 ═══════════════════════════ -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="24,20">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <ui:SymbolIcon
                            Symbol="VideoClip24"
                            FontSize="18"
                            Foreground="{DynamicResource FFluxSecondaryBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{loc:L Settings.Section.FFmpeg}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{loc:L Settings.FFmpeg.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="{loc:L Settings.FFmpeg.Placeholder}"
                            Text="{Binding FFmpegBinaryPath, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="Consolas, Courier New"
                            Margin="0,0,8,0" />

                        <ui:Button
                            Grid.Column="1"
                            Content="{loc:L Settings.Browse}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding BrowseFFmpegPathCommand}" />
                    </Grid>

                    <TextBlock
                        Text="{Binding FFmpegPathValidation}"
                        FontSize="12"
                        Foreground="{DynamicResource FFluxWarningBrush}"
                        Margin="0,6,0,0"
                        Visibility="{Binding FFmpegPathValidation,
                                     Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <!-- ══ Card: 출력 설정 ════════════════════════════ -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="24,20">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <ui:SymbolIcon
                            Symbol="Folder24"
                            FontSize="18"
                            Foreground="{DynamicResource FFluxSecondaryBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{loc:L Settings.Section.Output}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{loc:L Settings.Output.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="{loc:L Settings.Output.Placeholder}"
                            Text="{Binding DefaultOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="Consolas, Courier New"
                            Margin="0,0,8,0" />

                        <ui:Button
                            Grid.Column="1"
                            Content="{loc:L Settings.Browse}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding BrowseOutputFolderCommand}" />
                    </Grid>

                    <TextBlock
                        Text="{Binding OutputFolderValidation}"
                        FontSize="12"
                        Foreground="{DynamicResource FFluxWarningBrush}"
                        Margin="0,6,0,0"
                        Visibility="{Binding OutputFolderValidation,
                                     Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <!-- ══ Card: 언어 ══════════════════════════════════ -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="24,20">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <ui:SymbolIcon
                            Symbol="LocalLanguage24"
                            FontSize="18"
                            Foreground="{DynamicResource FFluxSecondaryBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{loc:L Settings.Section.Language}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{loc:L Settings.Language.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,16" />

                    <StackPanel
                        Orientation="Horizontal">
                        <Border
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,12,0"
                            MinWidth="160">
                            <RadioButton
                                Content="{loc:L Settings.Language.Korean}"
                                IsChecked="{Binding IsKoreanLanguage}"
                                GroupName="LanguageGroup"
                                FontSize="13" />
                        </Border>
                        <Border
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,12"
                            MinWidth="160">
                            <RadioButton
                                Content="{loc:L Settings.Language.English}"
                                IsChecked="{Binding IsEnglishLanguage}"
                                GroupName="LanguageGroup"
                                FontSize="13" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ══ Card: 디코더 설정 ══════════════════════════ -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="24,20">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <ui:SymbolIcon
                            Symbol="ArchiveMultiple24"
                            FontSize="18"
                            Foreground="{DynamicResource FFluxSecondaryBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{loc:L Settings.Section.Decoder}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{loc:L Settings.Decoder.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20" />

                    <!-- 하드웨어 가속 -->
                    <TextBlock
                        Text="{loc:L Settings.HwAccel.Label}"
                        FontSize="13"
                        FontWeight="Medium"
                        Margin="0,0,0,2" />
                    <TextBlock
                        Text="{loc:L Settings.HwAccel.Description}"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8" />
                    <ComboBox
                        SelectedValue="{Binding HwAccel}"
                        SelectedValuePath="Tag"
                        HorizontalAlignment="Left"
                        MinWidth="300"
                        Margin="0,0,0,20">
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.None}"   Tag="none" />
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.Auto}"   Tag="auto" />
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.D3D11VA}" Tag="d3d11va" />
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.DXVA2}"  Tag="dxva2" />
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.CUDA}"   Tag="cuda" />
                        <ComboBoxItem Content="{loc:L Settings.HwAccel.QSV}"    Tag="qsv" />
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 파일 디코더 스레드 수 -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock
                                Text="{loc:L Settings.FileThread.Label}"
                                FontSize="13"
                                FontWeight="Medium"
                                Margin="0,0,0,2" />
                            <TextBlock
                                Text="{loc:L Settings.FileThread.Description}"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,6" />
                            <ui:NumberBox
                                Value="{Binding FileThreadCount, Mode=TwoWay}"
                                Minimum="0" Maximum="32"
                                SmallChange="1" LargeChange="4"
                                SpinButtonPlacementMode="Inline"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- 디블록킹 필터 -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock
                                Text="{loc:L Settings.SkipLoop.Label}"
                                FontSize="13"
                                FontWeight="Medium"
                                Margin="0,0,0,2" />
                            <TextBlock
                                Text="{loc:L Settings.SkipLoop.Description}"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,6" />
                            <ComboBox
                                SelectedValue="{Binding SkipLoopFilter}"
                                SelectedValuePath="Tag"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{loc:L Settings.SkipLoop.None}"   Tag="none" />
                                <ComboBoxItem Content="{loc:L Settings.SkipLoop.NonRef}" Tag="nonref" />
                                <ComboBoxItem Content="{loc:L Settings.SkipLoop.All}"    Tag="all" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 프레임 건너뜀 -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock
                                Text="{loc:L Settings.SkipFrame.Label}"
                                FontSize="13"
                                FontWeight="Medium"
                                Margin="0,0,0,2" />
                            <TextBlock
                                Text="{loc:L Settings.SkipFrame.Description}"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,6" />
                            <ComboBox
                                SelectedValue="{Binding SkipFrame}"
                                SelectedValuePath="Tag"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{loc:L Settings.SkipFrame.None}"   Tag="none" />
                                <ComboBoxItem Content="{loc:L Settings.SkipFrame.NonRef}" Tag="nonref" />
                                <ComboBoxItem Content="{loc:L Settings.SkipFrame.NonKey}" Tag="nonkey" />
                                <ComboBoxItem Content="{loc:L Settings.SkipFrame.All}"    Tag="all" />
                            </ComboBox>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ══ Card: 스트리밍 옵션 ═══════════════════════ -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="24,20">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <ui:SymbolIcon
                            Symbol="Wifi124"
                            FontSize="18"
                            Foreground="{DynamicResource FFluxSecondaryBrush}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{loc:L Settings.Section.Streaming}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{loc:L Settings.Streaming.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20" />

                    <!-- RTSP 전송 프로토콜 -->
                    <TextBlock
                        Text="{loc:L Settings.RtspTransport.Label}"
                        FontSize="13"
                        FontWeight="Medium"
                        Margin="0,0,0,2" />
                    <TextBlock
                        Text="{loc:L Settings.RtspTransport.Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8" />
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,20">
                        <Border
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,10,0"
                            MinWidth="100">
                            <RadioButton Content="TCP" IsChecked="{Binding IsRtspTcp}" GroupName="RtspTransportGroup" FontSize="13" />
                        </Border>
                        <Border
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,10,0"
                            MinWidth="100">
                            <RadioButton Content="UDP" IsChecked="{Binding IsRtspUdp}" GroupName="RtspTransportGroup" FontSize="13" />
                        </Border>
                        <Border
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="14,10"
                            MinWidth="100">
                            <RadioButton Content="HTTP" IsChecked="{Binding IsRtspHttp}" GroupName="RtspTransportGroup" FontSize="13" />
                        </Border>
                    </StackPanel>

                    <!-- 6×2 그리드: 숫자 / bool 옵션 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: 연결 타임아웃 / 최대 A/V 지연 -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="{loc:L Settings.Timeout.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.Timeout.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="1" Maximum="120" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="{loc:L Settings.MaxDelay.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.MaxDelay.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding MaxDelayMs, Mode=TwoWay}" Minimum="0" Maximum="5000" SmallChange="100" LargeChange="500" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Row 2: 프로브 크기 / 스트림 분석 시간 -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Text="{loc:L Settings.ProbeSize.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.ProbeSize.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding ProbeSizeKb, Mode=TwoWay}" Minimum="32" Maximum="65536" SmallChange="100" LargeChange="500" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Text="{loc:L Settings.AnalyzeDuration.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.AnalyzeDuration.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding AnalyzeDurationSeconds, Mode=TwoWay}" Minimum="0.1" Maximum="30" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Row 4: 라이브 디코더 스레드 / 소켓 수신 버퍼 -->
                        <StackPanel Grid.Column="0" Grid.Row="4">
                            <TextBlock Text="{loc:L Settings.LiveThread.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.LiveThread.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding LiveThreadCount, Mode=TwoWay}" Minimum="1" Maximum="32" SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="4">
                            <TextBlock Text="{loc:L Settings.RecvBuffer.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.RecvBuffer.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding RecvBufferSizeKb, Mode=TwoWay}" Minimum="0" Maximum="65536" SmallChange="512" LargeChange="2048" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Row 6: RTP 재정렬 큐 / nobuffer + 재연결 -->
                        <StackPanel Grid.Column="0" Grid.Row="6">
                            <TextBlock Text="{loc:L Settings.ReorderQueue.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.ReorderQueue.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ui:NumberBox Value="{Binding ReorderQueueSize, Mode=TwoWay}" Minimum="0" Maximum="5000" SmallChange="100" LargeChange="500" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="6" VerticalAlignment="Top">
                            <TextBlock Text="{loc:L Settings.NoBuffer.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.NoBuffer.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="{loc:L Settings.NoBuffer.Check}" IsChecked="{Binding NoBuffer}" FontSize="13" Margin="0,0,0,16" />

                            <TextBlock Text="{loc:L Settings.Reconnect.Label}" FontSize="13" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:L Settings.Reconnect.Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="{loc:L Settings.Reconnect.Check}" IsChecked="{Binding Reconnect}" FontSize="13" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:L Settings.ReconnectDelay.Label}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox
                                    Value="{Binding ReconnectDelayMaxSeconds, Mode=TwoWay}"
                                    Minimum="0" Maximum="300" SmallChange="5" LargeChange="30"
                                    SpinButtonPlacementMode="Inline" Width="140"
                                    IsEnabled="{Binding Reconnect}" />
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ══ 버튼 영역 ════════════════════════════════ -->
            <StackPanel
                Orientation="Horizontal">

                <ui:Button
                    Content="{loc:L Settings.Save}"
                    Appearance="Primary"
                    Icon="{ui:SymbolIcon Save24}"
                    Command="{Binding SaveCommand}"
                    MinWidth="120"
                    Margin="0,0,12,0" />

                <ui:Button
                    Content="{loc:L Settings.Reset}"
                    Appearance="Secondary"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Command="{Binding ResetToDefaultsCommand}"
                    MinWidth="140" />

                <TextBlock
                    Text="{loc:L Settings.UnsavedChanges}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0"
                    Foreground="{DynamicResource FFluxWarningBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
