<Page
    x:Class="fflux.UI.Modules.SubtitleEditor.SubtitleEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:ctrl="clr-namespace:fflux.UI.Shared.Controls"
    xmlns:local="clr-namespace:fflux.UI.Modules.SubtitleEditor"
    xmlns:loc="clr-namespace:fflux.UI.Shared.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:SubtitleEditorViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    Title="Subtitle Editor"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    AllowDrop="True">

    <Page.Resources>
        <BooleanToVisibilityConverter             x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter    x:Key="InvBoolToVis" />
        <conv:NullToCollapsedConverter            x:Key="NullToCollapsed" />

        <Style x:Key="CueRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3Brush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1Brush}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartTimestampStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStartError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EndTimestampStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasEndError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11" />
            <Setter Property="Foreground"       Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"           Value="0,0,0,3" />
        </Style>

        <Style x:Key="PlayerBtnStyle" TargetType="Button">
            <Setter Property="Background"   Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"      Value="4" />
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Width"        Value="34" />
            <Setter Property="Height"       Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </Style>

        <Thickness x:Key="ToolbarBtnMargin">0,0,4,0</Thickness>
    </Page.Resources>

    <DockPanel LastChildFill="True">

        <!-- 툴바 -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource FFluxBorderBrush}"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding OpenFileCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.Open.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.Open.Label}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding SaveFileCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.Save.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.Save.Label}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding SaveFileAsCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.SaveAs.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="SaveEdit24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.SaveAs.Label}" />
                    </StackPanel>
                </ui:Button>

                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource FFluxBorderBrush}" />

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding AddCueBelowCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.Add.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.Add.Label}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding DeleteCueCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.Delete.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.Delete.Label}" />
                    </StackPanel>
                </ui:Button>

                <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource FFluxBorderBrush}" />

                <ui:Button Margin="{StaticResource ToolbarBtnMargin}"
                           Command="{Binding SeekToSelectedCueCommand}" Appearance="Secondary"
                           ToolTip="{loc:L SubtitleEditor.Seek.Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:L SubtitleEditor.Seek.Label}" />
                    </StackPanel>
                </ui:Button>

            </StackPanel>
        </Border>

        <!-- 상태 표시줄 -->
        <Border DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource FFluxBorderBrush}"
                Padding="12,4">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Border>

        <!-- 본문 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="5" />
                <RowDefinition Height="3*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- 비디오 영역 -->
            <Grid Grid.Row="0" Background="Black" ClipToBounds="True">
                <Image Source="{Binding PlayerVm.VideoBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

                <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding PlayerVm.IsFileOpen, Converter={StaticResource InvBoolToVis}}">
                    <ui:SymbolIcon Symbol="Video24" FontSize="40" Foreground="#44FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:L SubtitleEditor.Video.Hint}" FontSize="13"
                               Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="{loc:L SubtitleEditor.Video.Formats}" FontSize="11"
                               Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <ctrl:SubtitleOverlayControl
                    SubtitleText="{Binding ActiveCueText}"
                    SubtitleColor="{Binding ActiveCueBrush}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="60,0,60,52" IsHitTestVisible="False" />

                <Border VerticalAlignment="Bottom" Padding="10,4,10,6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider Grid.Row="0" Style="{StaticResource SeekSliderStyle}"
                                Minimum="0" Maximum="{Binding PlayerVm.DurationSeconds}"
                                Value="{Binding PlayerVm.PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding PlayerVm.CanSeek}" Margin="0,0,0,4" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" ToolTip="{loc:L SubtitleEditor.Play.Tooltip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerBtnStyle}">
                                        <Setter Property="Command" Value="{Binding PlayerVm.PlayCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlayerVm.IsPlaying}" Value="True">
                                                <Setter Property="Command" Value="{Binding PlayerVm.PauseCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <ui:SymbolIcon FontSize="18">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Play24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlayerVm.IsPlaying}" Value="True">
                                                        <Setter Property="Symbol" Value="Pause24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource PlayerBtnStyle}"
                                    Command="{Binding PlayerVm.StopCommand}"
                                    ToolTip="{loc:L SubtitleEditor.Stop.Tooltip}">
                                <ui:SymbolIcon Symbol="Stop24" FontSize="18" />
                            </Button>
                            <TextBlock Grid.Column="3" Text="{Binding PlayerVm.TimecodeText}"
                                       Foreground="White" FontSize="12" FontFamily="Consolas, Courier New"
                                       VerticalAlignment="Center" Margin="8,0,4,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource FFluxBorderBrush}" Cursor="SizeNS" />

            <!-- 자막 편집 영역 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="290" MinWidth="220" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <Grid Grid.Column="0">
                    <StackPanel Visibility="{Binding HasCues, Converter={StaticResource InvBoolToVis}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Subtitles24" FontSize="44"
                                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:L SubtitleEditor.Empty.Title}" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:L SubtitleEditor.Empty.Hint}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <DataGrid x:Name="CueDataGrid"
                              ItemsSource="{Binding Cues}"
                              SelectedItem="{Binding SelectedCue, Mode=TwoWay}"
                              RowStyle="{StaticResource CueRowStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              FontSize="13" RowHeight="28" BorderThickness="0"
                              Background="Transparent"
                              Visibility="{Binding HasCues, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="56" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment"   Value="Center" />
                                        <Setter Property="Padding"             Value="0,0,8,0" />
                                        <Setter Property="Foreground"          Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Width="130">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:L SubtitleEditor.Grid.Start}" />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StartTimestampStyle}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                                        <Setter Property="Padding"           Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                        <Setter Property="Padding"    Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Width="130">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:L SubtitleEditor.Grid.End}" />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EndTimestampStyle}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                                        <Setter Property="Padding"           Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                        <Setter Property="Padding"    Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="40" IsReadOnly="True">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{loc:L SubtitleEditor.Grid.Color}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="16" Height="16" CornerRadius="3"
                                                Background="{Binding ColorBrush}" BorderThickness="1"
                                                BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:L SubtitleEditor.Grid.Text}" />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
                                        <Setter Property="Padding"           Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Padding" Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource FFluxBorderBrush}" Cursor="SizeWE" />

                <!-- 상세 편집 패널 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0">
                    <Grid>
                        <TextBlock
                            Visibility="{Binding SelectedCue, Converter={StaticResource NullToCollapsed}, ConverterParameter=Invert}"
                            FontSize="13" Foreground="{DynamicResource TextFillColorDisabledBrush}"
                            TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <Run Text="—" />
                        </TextBlock>

                        <StackPanel Visibility="{Binding SelectedCue, Converter={StaticResource NullToCollapsed}}"
                                    DataContext="{Binding SelectedCue}" Margin="10,10,10,14">

                            <!-- 시작 시간 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="{loc:L SubtitleEditor.Detail.StartTime}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas, Courier New" FontSize="13" Padding="7,5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStartError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <ui:Button Grid.Column="1" Margin="4,0,0,0" Padding="7,5" Appearance="Secondary"
                                           Command="{Binding DataContext.SetStartFromPlayerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           ToolTip="{loc:L SubtitleEditor.Detail.SetStart.Tooltip}">
                                    <ui:SymbolIcon Symbol="PositionForward24" FontSize="13" />
                                </ui:Button>
                            </Grid>

                            <!-- 종료 시간 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="{loc:L SubtitleEditor.Detail.EndTime}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas, Courier New" FontSize="13" Padding="7,5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEndError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <ui:Button Grid.Column="1" Margin="4,0,0,0" Padding="7,5" Appearance="Secondary"
                                           Command="{Binding DataContext.SetEndFromPlayerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           ToolTip="{loc:L SubtitleEditor.Detail.SetEnd.Tooltip}">
                                    <ui:SymbolIcon Symbol="PositionForward24" FontSize="13" />
                                </ui:Button>
                            </Grid>

                            <!-- 자막 텍스트 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="{loc:L SubtitleEditor.Detail.Text}" />
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="7,5" MinHeight="70" MaxHeight="180"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                            <!-- 자막 색상 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="{loc:L SubtitleEditor.Detail.Color}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{x:Static local:SubtitleCueViewModel.ColorPresets}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ColorText, Mode=TwoWay}"
                                          Padding="8,5" FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"     Value="White" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush"    Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <SolidColorBrush>
                                                            <SolidColorBrush.Color>
                                                                <MultiBinding Converter="{x:Static conv:HexToColorConverter.Instance}">
                                                                    <Binding Path="Value" />
                                                                </MultiBinding>
                                                            </SolidColorBrush.Color>
                                                        </SolidColorBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="4" Margin="6,0,0,0"
                                        Background="{Binding ColorBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource TextFillColorDisabledBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 커스텀 색상 -->
                            <TextBlock Style="{StaticResource DetailLabel}" Text="{loc:L SubtitleEditor.Detail.CustomColor}" />
                            <TextBox Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas, Courier New" FontSize="13" Padding="7,5"
                                     Margin="0,0,0,10" />

                            <!-- 오류 안내 -->
                            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{loc:L SubtitleEditor.Detail.Error}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Grid>

    </DockPanel>
</Page>
