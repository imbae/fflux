<Page
    x:Class="fflux.UI.Modules.SubtitleEditor.SubtitleEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:fflux.UI.Shared.Converters"
    xmlns:ctrl="clr-namespace:fflux.UI.Shared.Controls"
    xmlns:local="clr-namespace:fflux.UI.Modules.SubtitleEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:SubtitleEditorViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    Title="Subtitle Editor"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    AllowDrop="True">

    <Page.Resources>
        <BooleanToVisibilityConverter
            x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter
            x:Key="InvBoolToVis" />
        <conv:NullToCollapsedConverter
            x:Key="NullToCollapsed" />

        <!-- ── 선택 + 활성 큐 행 스타일 ─────────────────────────── -->
        <Style
            x:Key="CueRowStyle"
            TargetType="DataGridRow">
            <Style.Triggers>
                <!-- 선택된 행 -->
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter
                        Property="Foreground"
                        Value="White" />
                </Trigger>
                <!-- 현재 재생 중인 큐 (활성) -->
                <DataTrigger
                    Binding="{Binding IsActive}"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource SystemAccentColorLight3Brush}" />
                    <Setter
                        Property="FontWeight"
                        Value="SemiBold" />
                </DataTrigger>
                <!-- 선택 + 활성 동시에 — 선택이 우선 (트리거 순서: 아래가 나중에 적용됨) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding IsActive}"
                            Value="True" />
                        <Condition
                            Binding="{Binding RelativeSource={RelativeSource Self},
                                            Path=IsSelected}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource SystemAccentColorDark1Brush}" />
                    <Setter
                        Property="Foreground"
                        Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 타임스탬프 오류 셀 스타일 ─────────────────────────── -->
        <Style
            x:Key="StartTimestampStyle"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding HasStartError}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="EndTimestampStyle"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding HasEndError}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 상세패널 레이블 스타일 ────────────────────────────── -->
        <Style
            x:Key="DetailLabel"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="11" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="Margin"
                Value="0,0,0,3" />
        </Style>

        <!-- ── 플레이어 버튼 (아이콘 전용) ──────────────────────── -->
        <Style
            x:Key="PlayerBtnStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="4" />
            <Setter
                Property="Foreground"
                Value="White" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Width"
                Value="34" />
            <Setter
                Property="Height"
                Value="34" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    Property="Background"
                                    Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger
                                Property="IsPressed"
                                Value="True">
                                <Setter
                                    Property="Background"
                                    Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False">
                                <Setter
                                    Property="Opacity"
                                    Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 시크 슬라이더 ────────────────────────────────────── -->
        <Style
            x:Key="SeekSliderStyle"
            TargetType="Slider">
            <Setter
                Property="Foreground"
                Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </Style>

        <Thickness
            x:Key="ToolbarBtnMargin">0,0,4,0</Thickness>
    </Page.Resources>

    <!-- ══ 최상위 DockPanel: Toolbar / StatusBar / 본문 ══════════════ -->
    <DockPanel
        LastChildFill="True">

        <!-- ── 툴바 ──────────────────────────────────────────────── -->
        <Border
            DockPanel.Dock="Top"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource FFluxBorderBrush}"
            Padding="8,6">
            <StackPanel
                Orientation="Horizontal">
                <!-- 자막 열기 / 저장 그룹 -->
                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding OpenFileCommand}"
                    Appearance="Secondary"
                    ToolTip="자막 파일 열기  (Ctrl+O)">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="FolderOpen24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="자막 열기" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding SaveFileCommand}"
                    Appearance="Secondary"
                    ToolTip="저장  (Ctrl+S)">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="Save24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="저장" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding SaveFileAsCommand}"
                    Appearance="Secondary"
                    ToolTip="다른 이름으로 저장">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="SaveEdit24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="다른 이름" />
                    </StackPanel>
                </ui:Button>

                <!-- 구분선 -->
                <Rectangle
                    Width="1"
                    Height="18"
                    Margin="6,0"
                    Fill="{DynamicResource FFluxBorderBrush}" />

                <!-- 편집 그룹 -->
                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding AddCueBelowCommand}"
                    Appearance="Secondary"
                    ToolTip="선택 항목 아래에 자막 추가  (Ins)">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="Add24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="추가" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding DeleteCueCommand}"
                    Appearance="Secondary"
                    ToolTip="선택한 자막 삭제  (Ctrl+Del)">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="Delete24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="삭제" />
                    </StackPanel>
                </ui:Button>

                <!-- 구분선 -->
                <Rectangle
                    Width="1"
                    Height="18"
                    Margin="6,0"
                    Fill="{DynamicResource FFluxBorderBrush}" />

                <!-- 재생 연동 -->
                <ui:Button
                    Margin="{StaticResource ToolbarBtnMargin}"
                    Command="{Binding SeekToSelectedCueCommand}"
                    Appearance="Secondary"
                    ToolTip="선택한 자막 위치로 플레이어 이동">
                    <StackPanel
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Symbol="ArrowRight24"
                            FontSize="14"
                            Margin="0,0,5,0" />
                        <TextBlock
                            Text="위치로 이동" />
                    </StackPanel>
                </ui:Button>

            </StackPanel>
        </Border>

        <!-- ── 상태 표시줄 ────────────────────────────────────────── -->
        <Border
            DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource FFluxBorderBrush}"
            Padding="12,4">
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
        </Border>

        <!-- ══ 본문: 비디오(상) + 에디터(하) ════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- 비디오 영역 -->
                <RowDefinition
                    Height="2*"
                    MinHeight="120" />
                <!-- 수직 구분선 -->
                <RowDefinition
                    Height="5" />
                <!-- 자막 편집 영역 -->
                <RowDefinition
                    Height="3*"
                    MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 ① 비디오 영역
            ══════════════════════════════════════════════════════ -->
            <Grid
                Grid.Row="0"
                Background="Black"
                ClipToBounds="True">

                <!-- 비디오 프레임 -->
                <Image
                    Source="{Binding PlayerVm.VideoBitmap}"
                    Stretch="Uniform"
                    RenderOptions.BitmapScalingMode="Linear" />

                <!-- 파일 미오픈 안내 -->
                <StackPanel
                    IsHitTestVisible="False"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding PlayerVm.IsFileOpen, Converter={StaticResource InvBoolToVis}}">
                    <ui:SymbolIcon
                        Symbol="Video24"
                        FontSize="40"
                        Foreground="#44FFFFFF"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="비디오 파일을 드롭하거나 [비디오] 버튼을 누르세요"
                        FontSize="13"
                        Foreground="#66FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0" />
                    <TextBlock
                        Text="MP4 · MKV · AVI · MOV · WebM · TS"
                        FontSize="11"
                        Foreground="#44FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>

                <!-- 자막 오버레이 -->
                <ctrl:SubtitleOverlayControl
                    SubtitleText="{Binding ActiveCueText}"
                    SubtitleColor="{Binding ActiveCueBrush}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="60,0,60,52"
                    IsHitTestVisible="False" />

                <!-- 플레이어 컨트롤 바 (하단 오버레이) -->
                <Border
                    VerticalAlignment="Bottom"
                    Padding="10,4,10,6">
                    <Border.Background>
                        <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="0,1">
                            <GradientStop
                                Color="#00000000"
                                Offset="0" />
                            <GradientStop
                                Color="#CC000000"
                                Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 시크 슬라이더 -->
                        <Slider
                            Grid.Row="0"
                            Style="{StaticResource SeekSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding PlayerVm.DurationSeconds}"
                            Value="{Binding PlayerVm.PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding PlayerVm.CanSeek}"
                            Margin="0,0,0,4" />

                        <!-- 버튼 + 타임코드 -->
                        <Grid
                            Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 재생 / 일시정지 (IsPlaying에 따라 아이콘 + 커맨드 전환) -->
                            <Button
                                Grid.Column="0"
                                ToolTip="재생 / 일시정지  (Space)">
                                <Button.Style>
                                    <Style
                                        TargetType="Button"
                                        BasedOn="{StaticResource PlayerBtnStyle}">
                                        <Setter
                                            Property="Command"
                                            Value="{Binding PlayerVm.PlayCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding PlayerVm.IsPlaying}"
                                                Value="True">
                                                <Setter
                                                    Property="Command"
                                                    Value="{Binding PlayerVm.PauseCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <ui:SymbolIcon
                                        FontSize="18">
                                        <ui:SymbolIcon.Style>
                                            <Style
                                                TargetType="ui:SymbolIcon">
                                                <Setter
                                                    Property="Symbol"
                                                    Value="Play24" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding PlayerVm.IsPlaying}"
                                                        Value="True">
                                                        <Setter
                                                            Property="Symbol"
                                                            Value="Pause24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Button.Content>
                            </Button>

                            <!-- 정지 -->
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource PlayerBtnStyle}"
                                Command="{Binding PlayerVm.StopCommand}"
                                ToolTip="정지">
                                <ui:SymbolIcon
                                    Symbol="Stop24"
                                    FontSize="18" />
                            </Button>

                            <!-- 타임코드 -->
                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding PlayerVm.TimecodeText}"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Consolas, Courier New"
                                VerticalAlignment="Center"
                                Margin="8,0,4,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── 수직 GridSplitter ────────────────────────────── -->
            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource FFluxBorderBrush}"
                Cursor="SizeNS" />

            <!-- ══════════════════════════════════════════════════════
                 ② 자막 편집 영역
            ══════════════════════════════════════════════════════ -->
            <Grid
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- DataGrid -->
                    <ColumnDefinition
                        Width="*"
                        MinWidth="260" />
                    <!-- 수평 구분선 -->
                    <ColumnDefinition
                        Width="4" />
                    <!-- 상세 편집 패널 -->
                    <ColumnDefinition
                        Width="290"
                        MinWidth="220"
                        MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- ── ① DataGrid 영역 ──────────────────────────── -->
                <Grid
                    Grid.Column="0">

                    <!-- 빈 상태 안내 -->
                    <StackPanel
                        Visibility="{Binding HasCues, Converter={StaticResource InvBoolToVis}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Subtitles24"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorDisabledBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10" />
                        <TextBlock
                            Text="SRT / VTT 파일을 열거나 끌어다 놓으세요"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="또는 위 [자막 열기] 버튼을 누르세요"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorDisabledBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid
                        x:Name="CueDataGrid"
                        ItemsSource="{Binding Cues}"
                        SelectedItem="{Binding SelectedCue, Mode=TwoWay}"
                        RowStyle="{StaticResource CueRowStyle}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        SelectionMode="Single"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="13"
                        RowHeight="28"
                        BorderThickness="0"
                        Background="Transparent"
                        Visibility="{Binding HasCues, Converter={StaticResource BoolToVis}}">

                        <DataGrid.Columns>

                            <!-- # (인덱스) — 4자리(9999)까지 표시 -->
                            <DataGridTextColumn
                                Header="#"
                                Binding="{Binding Index}"
                                Width="56"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style
                                        TargetType="TextBlock">
                                        <Setter
                                            Property="HorizontalAlignment"
                                            Value="Right" />
                                        <Setter
                                            Property="VerticalAlignment"
                                            Value="Center" />
                                        <Setter
                                            Property="Padding"
                                            Value="0,0,8,0" />
                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 시작 시간 -->
                            <DataGridTextColumn
                                Header="시작"
                                Binding="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style
                                        TargetType="TextBlock"
                                        BasedOn="{StaticResource StartTimestampStyle}">
                                        <Setter
                                            Property="VerticalAlignment"
                                            Value="Center" />
                                        <Setter
                                            Property="FontFamily"
                                            Value="Consolas, Courier New" />
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style
                                        TargetType="TextBox">
                                        <Setter
                                            Property="FontFamily"
                                            Value="Consolas, Courier New" />
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 종료 시간 -->
                            <DataGridTextColumn
                                Header="끝"
                                Binding="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style
                                        TargetType="TextBlock"
                                        BasedOn="{StaticResource EndTimestampStyle}">
                                        <Setter
                                            Property="VerticalAlignment"
                                            Value="Center" />
                                        <Setter
                                            Property="FontFamily"
                                            Value="Consolas, Courier New" />
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style
                                        TargetType="TextBox">
                                        <Setter
                                            Property="FontFamily"
                                            Value="Consolas, Courier New" />
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 색상 미리보기 (16px 컬러 스왓치) -->
                            <DataGridTemplateColumn
                                Header="색상"
                                Width="40"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="16"
                                            Height="16"
                                            CornerRadius="3"
                                            Background="{Binding ColorBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 자막 텍스트 -->
                            <DataGridTextColumn
                                Header="자막 텍스트"
                                Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style
                                        TargetType="TextBlock">
                                        <Setter
                                            Property="VerticalAlignment"
                                            Value="Center" />
                                        <Setter
                                            Property="TextTrimming"
                                            Value="CharacterEllipsis" />
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style
                                        TargetType="TextBox">
                                        <Setter
                                            Property="Padding"
                                            Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ── 수평 GridSplitter ──────────────────────── -->
                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource FFluxBorderBrush}"
                    Cursor="SizeWE" />

                <!-- ── ② 상세 편집 패널 ──────────────────────── -->
                <ScrollViewer
                    Grid.Column="2"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0">

                    <Grid>

                        <!-- 선택 없음 안내 -->
                        <TextBlock
                            Visibility="{Binding SelectedCue, Converter={StaticResource NullToCollapsed},
                                         ConverterParameter=Invert}"
                            Text="자막을 선택하면&#10;여기서 편집할 수 있습니다"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorDisabledBrush}"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="16" />

                        <!-- 상세 편집 영역 -->
                        <StackPanel
                            Visibility="{Binding SelectedCue, Converter={StaticResource NullToCollapsed}}"
                            DataContext="{Binding SelectedCue}"
                            Margin="10,10,10,14">

                            <!-- 시작 시간 -->
                            <TextBlock
                                Style="{StaticResource DetailLabel}"
                                Text="시작 시간" />
                            <Grid
                                Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="Consolas, Courier New"
                                    FontSize="13"
                                    Padding="7,5">
                                    <TextBox.Style>
                                        <Style
                                            TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HasStartError}"
                                                    Value="True">
                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="7,5"
                                    Appearance="Secondary"
                                    Command="{Binding DataContext.SetStartFromPlayerCommand,
                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                    ToolTip="현재 재생 위치를 시작 시간으로 설정">
                                    <ui:SymbolIcon
                                        Symbol="PositionForward24"
                                        FontSize="13" />
                                </ui:Button>
                            </Grid>

                            <!-- 종료 시간 -->
                            <TextBlock
                                Style="{StaticResource DetailLabel}"
                                Text="종료 시간" />
                            <Grid
                                Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="Consolas, Courier New"
                                    FontSize="13"
                                    Padding="7,5">
                                    <TextBox.Style>
                                        <Style
                                            TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HasEndError}"
                                                    Value="True">
                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="7,5"
                                    Appearance="Secondary"
                                    Command="{Binding DataContext.SetEndFromPlayerCommand,
                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                    ToolTip="현재 재생 위치를 종료 시간으로 설정">
                                    <ui:SymbolIcon
                                        Symbol="PositionForward24"
                                        FontSize="13" />
                                </ui:Button>
                            </Grid>

                            <!-- 자막 텍스트 -->
                            <TextBlock
                                Style="{StaticResource DetailLabel}"
                                Text="자막 텍스트" />
                            <TextBox
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="13"
                                Padding="7,5"
                                MinHeight="70"
                                MaxHeight="180"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,10" />

                            <!-- 자막 색상 -->
                            <TextBlock
                                Style="{StaticResource DetailLabel}"
                                Text="자막 색상" />
                            <Grid
                                Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 프리셋 ComboBox -->
                                <ComboBox
                                    Grid.Column="0"
                                    ItemsSource="{x:Static local:SubtitleCueViewModel.ColorPresets}"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding ColorText, Mode=TwoWay}"
                                    Padding="8,5"
                                    FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Orientation="Horizontal">
                                                <Border
                                                    Width="14"
                                                    Height="14"
                                                    CornerRadius="2"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style
                                                            TargetType="Border">
                                                            <Setter
                                                                Property="Background"
                                                                Value="White" />
                                                            <Setter
                                                                Property="BorderThickness"
                                                                Value="1" />
                                                            <Setter
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding Value}"
                                                                    Value="">
                                                                    <Setter
                                                                        Property="Visibility"
                                                                        Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <SolidColorBrush>
                                                            <SolidColorBrush.Color>
                                                                <MultiBinding
                                                                    Converter="{x:Static conv:HexToColorConverter.Instance}">
                                                                    <Binding
                                                                        Path="Value" />
                                                                </MultiBinding>
                                                            </SolidColorBrush.Color>
                                                        </SolidColorBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 색상 미리보기 스왓치 -->
                                <Border
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="4"
                                    Margin="6,0,0,0"
                                    Background="{Binding ColorBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- 커스텀 색상 HEX 입력 -->
                            <TextBlock
                                Style="{StaticResource DetailLabel}"
                                Text="직접 입력 (#RRGGBB)" />
                            <TextBox
                                Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="Consolas, Courier New"
                                FontSize="13"
                                Padding="7,5"
                                Margin="0,0,0,10"
                                ToolTip="예: #FFFFFF (흰색), #FFE000 (노랑)" />

                            <!-- 오류 안내 -->
                            <Border
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,6">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Symbol="ErrorCircle24"
                                        FontSize="14"
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock
                                        Text="타임스탬프 형식 오류&#10;HH:MM:SS,mmm 으로 입력하세요"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Grid>

    </DockPanel>
</Page>
