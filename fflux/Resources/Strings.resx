  <data name="Settings.Section.Decoder" xml:space="preserve"><value>Decoder Settings</value></data>
  <data name="Settings.Decoder.Description" xml:space="preserve"><value>Applied to all sources: files, streaming, capture devices, etc.</value></data>
  <data name="Settings.HwAccel.Label" xml:space="preserve"><value>Hardware Acceleration (hwaccel)</value></data>
  <data name="Settings.HwAccel.Description" xml:space="preserve"><value>Use GPU hardware decoder to significantly reduce CPU load. Falls back to software decoding on failure. D3D11VA for Windows 10+, DXVA2 for legacy, CUDA for NVIDIA, QSV for Intel.</value></data>
  <data name="Settings.HwAccel.None" xml:space="preserve"><value>None — Software Decoding (Default)</value></data>
  <data name="Settings.HwAccel.Auto" xml:space="preserve"><value>Auto Detect — Try D3D11VA first</value></data>
  <data name="Settings.HwAccel.D3D11VA" xml:space="preserve"><value>D3D11VA — Windows 10+ GPU</value></data>
  <data name="Settings.HwAccel.DXVA2" xml:space="preserve"><value>DXVA2 — Legacy Windows GPU</value></data>
  <data name="Settings.HwAccel.CUDA" xml:space="preserve"><value>CUDA — NVIDIA GPU</value></data>
  <data name="Settings.HwAccel.QSV" xml:space="preserve"><value>QSV — Intel Quick Sync Video</value></data>
  <data name="Settings.FileThread.Label" xml:space="preserve"><value>File Decoder Threads (thread_count)</value></data>
  <data name="Settings.FileThread.Description" xml:space="preserve"><value>Decoding threads for file playback. 0 = auto (CPU cores). More threads increase throughput but also memory. (Default: 0)</value></data>
  <data name="Settings.SkipLoop.Label" xml:space="preserve"><value>Deblocking Filter Skip (skip_loop_filter)</value></data>
  <data name="Settings.SkipLoop.Description" xml:space="preserve"><value>Limit H.264/HEVC deblocking filter scope to reduce CPU load. "Non-reference" provides 15~20% speedup without quality loss. (Default: None)</value></data>
  <data name="Settings.SkipLoop.None" xml:space="preserve"><value>None — Always apply (Default)</value></data>
  <data name="Settings.SkipLoop.NonRef" xml:space="preserve"><value>Non-reference frames — Recommended</value></data>
  <data name="Settings.SkipLoop.All" xml:space="preserve"><value>All — Max performance, quality loss</value></data>
  <data name="Settings.SkipFrame.Label" xml:space="preserve"><value>Frame Skip Level (skip_frame)</value></data>
  <data name="Settings.SkipFrame.Description" xml:space="preserve"><value>Limit frame types to decode. Non-ref = reference frames only, Non-key = keyframes only (slideshow). (Default: None)</value></data>
  <data name="Settings.SkipFrame.None" xml:space="preserve"><value>None — Decode all frames (Default)</value></data>
  <data name="Settings.SkipFrame.NonRef" xml:space="preserve"><value>Skip non-reference frames</value></data>
  <data name="Settings.SkipFrame.NonKey" xml:space="preserve"><value>Skip non-keyframes — keyframes only</value></data>
  <data name="Settings.SkipFrame.All" xml:space="preserve"><value>Skip all</value></data>
  <data name="Settings.Section.Streaming" xml:space="preserve"><value>Streaming Options</value></data>
  <data name="Settings.Streaming.Description" xml:space="preserve"><value>Applied only during network streaming (RTSP · RTP · UDP · HTTP). Adjust to your network environment.</value></data>
  <data name="Settings.RtspTransport.Label" xml:space="preserve"><value>RTSP Transport (rtsp_transport)</value></data>
  <data name="Settings.RtspTransport.Description" xml:space="preserve"><value>Applies to RTSP URLs only. TCP: stable behind firewall/NAT. UDP: low latency but packet-loss prone. HTTP: use when proxy is needed.</value></data>
  <data name="Settings.Timeout.Label" xml:space="preserve"><value>Connection Timeout (s, timeout)</value></data>
  <data name="Settings.Timeout.Description" xml:space="preserve"><value>Connection fails if server doesn't respond within this time. (Default: 10)</value></data>
  <data name="Settings.MaxDelay.Label" xml:space="preserve"><value>Max A/V Delay (ms, max_delay)</value></data>
  <data name="Settings.MaxDelay.Description" xml:space="preserve"><value>Maximum A/V demuxing delay. Smaller reduces latency but increases jitter sensitivity. (Default: 500)</value></data>
  <data name="Settings.ProbeSize.Label" xml:space="preserve"><value>Probe Size (KB, probesize)</value></data>
  <data name="Settings.ProbeSize.Description" xml:space="preserve"><value>Max data size for codec/stream detection. Smaller starts faster but less accurate. (Default: 500)</value></data>
  <data name="Settings.AnalyzeDuration.Label" xml:space="preserve"><value>Analyze Duration (s, analyzeduration)</value></data>
  <data name="Settings.AnalyzeDuration.Description" xml:space="preserve"><value>Max time for stream analysis. Smaller starts faster but may miss audio/subtitle. (Default: 1.0)</value></data>
  <data name="Settings.LiveThread.Label" xml:space="preserve"><value>Live Decoder Threads (thread_count)</value></data>
  <data name="Settings.LiveThread.Description" xml:space="preserve"><value>FF_THREAD_FRAME adds (N-1) frame delay. e.g. 8 cores → ~280ms. Recommend 1 for live. (Default: 1)</value></data>
  <data name="Settings.RecvBuffer.Label" xml:space="preserve"><value>Recv Buffer (KB, recv_buffer_size)</value></data>
  <data name="Settings.RecvBuffer.Description" xml:space="preserve"><value>UDP receive buffer size. 0 = system default. Increase if packet loss on high-res UDP. (Default: 0)</value></data>
  <data name="Settings.ReorderQueue.Label" xml:space="preserve"><value>RTP Reorder Queue (reorder_queue_size)</value></data>
  <data name="Settings.ReorderQueue.Description" xml:space="preserve"><value>Reorder out-of-sequence UDP/RTP packets. 0 = disabled. Larger = better jitter tolerance, higher latency. (Default: 500)</value></data>
  <data name="Settings.NoBuffer.Label" xml:space="preserve"><value>Disable Internal Buffer (fflags=nobuffer)</value></data>
  <data name="Settings.NoBuffer.Description" xml:space="preserve"><value>Deliver packets without buffering. Without this FFmpeg bursts packets causing stuttering. (Default: enabled)</value></data>
  <data name="Settings.NoBuffer.Check" xml:space="preserve"><value>Enable nobuffer</value></data>
  <data name="Settings.Reconnect.Label" xml:space="preserve"><value>Auto Reconnect (reconnect)</value></data>
  <data name="Settings.Reconnect.Description" xml:space="preserve"><value>Automatically reconnect on disconnect or EOF. Effective for HTTP streams. (Default: disabled)</value></data>
  <data name="Settings.Reconnect.Check" xml:space="preserve"><value>Enable auto-reconnect</value></data>
  <data name="Settings.ReconnectDelay.Label" xml:space="preserve"><value>Max wait (s):</value></data>
  <data name="Settings.Save" xml:space="preserve"><value>Save Settings</value></data>
  <data name="Settings.Reset" xml:space="preserve"><value>Reset to Defaults</value></data>
  <data name="Settings.UnsavedChanges" xml:space="preserve"><value>● You have unsaved changes.</value></data>
